#: src/fieldspec.cpp:88
#, kde-format
msgid "Field \"%1\": expected NAME:TYPE:Label[:Default[:Extra]]"
msgstr "Feld „%1“: erwartet wurde NAME:TYP:Beschriftung[:Vorgabe[:Extra]]"

#: src/fieldspec.cpp:97
#, kde-format
msgid ""
"Field \"%1\": unknown type \"%2\". Known: text, pass, int, check, combo, "
"file, dir, date"
msgstr ""
"Feld „%1“: unbekannter Typ „%2“. Bekannt sind: text, pass, int, check, "
"combo, file, dir, date"

#: src/fieldspec.cpp:104
#, kde-format
msgid ""
"Field \"%1\": the name may not be empty, it is what the value is printed "
"under"
msgstr ""
"Feld „%1“: der Name darf nicht leer sein, unter ihm wird der Wert ausgegeben"

#: src/fieldspec.cpp:122
#, kde-format
msgid "Field \"%1\": a combo needs its choices as Default, separated by \"|\""
msgstr ""
"Feld „%1“: ein Auswahlfeld braucht seine Einträge als Vorgabe, getrennt "
"durch „|“"

#: src/fieldspec.cpp:152
#, kde-format
msgid "Field \"%1\": the range must read MIN-MAX, for example 10-51"
msgstr "Feld „%1“: der Bereich muss MIN-MAX lauten, zum Beispiel 10-51"

#: src/main.cpp:120
#, kde-format
msgid "Cannot load the %1 window: %2"
msgstr "Das Fenster „%1“ kann nicht geladen werden: %2"

#: src/main.cpp:155
#, kde-format
msgid "--form needs at least one --field NAME:TYPE:Label[:Default[:Extra]]"
msgstr ""
"--form braucht mindestens ein --field NAME:TYP:Beschriftung[:Vorgabe[:Extra]]"

#: src/main.cpp:229
#, kde-format
msgid "Cannot read \"%1\": %2"
msgstr "„%1“ kann nicht gelesen werden: %2"

#: src/main.cpp:300
#, kde-format
msgid "Cannot register \"%1\" on the session bus"
msgstr "„%1“ kann nicht am Sitzungsbus angemeldet werden"

#: src/main.cpp:362
#, kde-format
msgid "--passivepopup takes its timeout in seconds, for example 5"
msgstr "--passivepopup erwartet die Anzeigedauer in Sekunden, zum Beispiel 5"

#: src/main.cpp:406
#, kde-format
msgid "Cannot start the progress dialog"
msgstr "Der Fortschrittsdialog kann nicht gestartet werden"

#: src/main.cpp:429
#, kde-format
msgid "The progress dialog did not come up on the session bus"
msgstr "Der Fortschrittsdialog ist nicht am Sitzungsbus erschienen"

#: src/main.cpp:449
#, kde-format
msgid "kurodlg"
msgstr "kurodlg"

#: src/main.cpp:450
#, kde-format
msgid ""
"Dialogs for shell scripts and service menus: a progress window with a "
"details area, a multi-field form, a window that shows a command's output, "
"and notifications."
msgstr ""
"Dialoge für Shell-Skripte und Dienstmenüs: ein Fortschrittsfenster mit "
"Detailbereich, ein Formular mit mehreren Feldern, ein Fenster, das die "
"Ausgabe eines Befehls anzeigt, und Benachrichtigungen."

#: src/main.cpp:452
#, kde-format
msgid "© 2026 Pascal Klose"
msgstr "© 2026 Pascal Klose"

#: src/main.cpp:453
#, kde-format
msgid "Pascal Klose"
msgstr "Pascal Klose"

#: src/main.cpp:469
#, kde-format
msgid ""
"Show a progress window and print \"<service> <path>\" to drive it over D-Bus."
msgstr ""
"Ein Fortschrittsfenster anzeigen und „<Dienst> <Pfad>“ ausgeben, um es über "
"D-Bus zu steuern."

#: src/main.cpp:470 src/main.cpp:471 src/main.cpp:477 src/main.cpp:479
#: src/main.cpp:480 src/main.cpp:489
#, kde-format
msgid "text"
msgstr "Text"

#: src/main.cpp:471
#, kde-format
msgid "Show a form built from the --field arguments."
msgstr "Ein Formular anzeigen, das aus den --field-Argumenten gebaut wird."

#: src/main.cpp:472
#, kde-format
msgid "A form field, NAME:TYPE:Label[:Default[:Extra]]. Repeatable."
msgstr ""
"Ein Formularfeld, NAME:TYP:Beschriftung[:Vorgabe[:Extra]]. Mehrfach "
"verwendbar."

#: src/main.cpp:472 src/main.cpp:476
#, kde-format
msgid "spec"
msgstr "Angabe"

#: src/main.cpp:474
#, kde-format
msgid ""
"Picking CHOICE in the combo FIELD sets the named fields, "
"FIELD:CHOICE:NAME=VALUE[:NAME=VALUE...]. Repeatable."
msgstr ""
"Die Wahl von EINTRAG im Auswahlfeld FELD setzt die genannten Felder, "
"FELD:EINTRAG:NAME=WERT[:NAME=WERT...]. Mehrfach verwendbar."

#: src/main.cpp:477
#, kde-format
msgid "Show a window with the text arriving on stdin."
msgstr ""
"Ein Fenster mit dem Text anzeigen, der auf der Standardeingabe eintrifft."

#: src/main.cpp:478
#, kde-format
msgid "Read --textbox content from this file instead of stdin."
msgstr ""
"Den Inhalt für --textbox aus dieser Datei lesen statt von der "
"Standardeingabe."

#: src/main.cpp:478
#, kde-format
msgid "path"
msgstr "Pfad"

#: src/main.cpp:479
#, kde-format
msgid "Window title."
msgstr "Fenstertitel."

#: src/main.cpp:480
#, kde-format
msgid "A heading shown inside the dialog, above the label."
msgstr "Eine Überschrift im Dialog, über der Beschriftung."

#: src/main.cpp:481
#, kde-format
msgid "Window icon, by icon theme name."
msgstr "Fenstersymbol, nach Name im Symboldesign."

#: src/main.cpp:481 src/main.cpp:485
#, kde-format
msgid "name"
msgstr "Name"

#: src/main.cpp:482
#, kde-format
msgid "Window size, for example 640x420."
msgstr "Fenstergröße, zum Beispiel 640x420."

#: src/main.cpp:482
#, kde-format
msgid "WxH"
msgstr "BxH"

#: src/main.cpp:483
#, kde-format
msgid "Start with the details area expanded."
msgstr "Mit ausgeklapptem Detailbereich starten."

#: src/main.cpp:484
#, kde-format
msgid ""
"Show the progress on this desktop entry's task icon instead of kurodlg's."
msgstr ""
"Den Fortschritt auf dem Symbol dieses Desktop-Eintrags anzeigen statt auf "
"dem von kurodlg."

#: src/main.cpp:486
#, kde-format
msgid ""
"Show the About page: version, authors, licence and where to report bugs."
msgstr ""
"Die Über-Seite zeigen: Version, Autoren, Lizenz und wohin Fehler gemeldet "
"werden."

#: src/main.cpp:487
#, kde-format
msgid ""
"With --progress: no window, show the progress as a Plasma job notification "
"instead."
msgstr ""
"Mit --progress: kein Fenster, der Fortschritt erscheint stattdessen als "
"Plasma-Auftragsbenachrichtigung."

#: src/main.cpp:489
#, kde-format
msgid ""
"Show a notification with this text; an optional TIMEOUT in seconds closes it "
"earlier."
msgstr ""
"Eine Benachrichtigung mit diesem Text zeigen; eine optionale Anzeigedauer in "
"Sekunden schließt sie früher."

#: src/main.cpp:499
#, kde-format
msgid ""
"With --progress: the steps the bar counts to, default 100. With --"
"passivepopup: the timeout."
msgstr ""
"Mit --progress: die Schritte, bis zu denen der Balken zählt, Standard 100. "
"Mit --passivepopup: die Anzeigedauer."

#: src/main.cpp:513
#, kde-format
msgid "--size takes WIDTHxHEIGHT, for example 640x420"
msgstr "--size erwartet BREITExHÖHE, zum Beispiel 640x420"

#: src/presetspec.cpp:21
#, kde-format
msgid "Preset \"%1\": expected FIELD:CHOICE:NAME=VALUE[:NAME=VALUE...]"
msgstr "Vorlage „%1“: erwartet wurde FELD:EINTRAG:NAME=WERT[:NAME=WERT...]"

#: src/presetspec.cpp:33
#, kde-format
msgid "Preset \"%1\": \"%2\" is not NAME=VALUE"
msgstr "Vorlage „%1“: „%2“ hat nicht die Form NAME=WERT"

#: src/presetspec.cpp:97
#, kde-format
msgid "Preset for \"%1\": there is no combo field of that name"
msgstr "Vorlage für „%1“: es gibt kein Auswahlfeld dieses Namens"

#: src/presetspec.cpp:103
#, kde-format
msgid "Preset for \"%1\": \"%2\" is not one of its choices"
msgstr "Vorlage für „%1“: „%2“ ist keiner seiner Einträge"

#: src/presetspec.cpp:113
#, kde-format
msgid "Preset \"%1\": there is no other field named \"%2\""
msgstr "Vorlage „%1“: es gibt kein anderes Feld namens „%2“"

#: src/presetspec.cpp:121
#, kde-format
msgid "Preset \"%1\": \"%2\" cannot take \"%3\""
msgstr "Vorlage „%1“: „%2“ kann „%3“ nicht annehmen"

#: src/qml/AboutWindow.qml:12
#, kde-format
msgid "About kurodlg"
msgstr "Über kurodlg"

#: src/qml/FormWindow.qml:163
#, kde-format
msgid "Browse…"
msgstr "Durchsuchen …"

#: src/qml/ProgressWindow.qml:66
#, kde-format
msgid "Details"
msgstr "Details"

#: src/qml/ProgressWindow.qml:108
#, kde-format
msgid "Copied"
msgstr "Kopiert"

#: src/qml/ProgressWindow.qml:108
#, kde-format
msgid "Copy"
msgstr "Kopieren"

#: src/qml/ProgressWindow.qml:109
#, kde-format
msgid "Copy the whole output to the clipboard"
msgstr "Die gesamte Ausgabe in die Zwischenablage kopieren"

#: src/qml/ProgressWindow.qml:138
#, kde-format
msgid "Close"
msgstr "Schließen"

#: src/qml/ProgressWindow.qml:142
#, kde-format
msgid "Cancelling…"
msgstr "Wird abgebrochen …"

#: src/qml/ProgressWindow.qml:145
#, kde-format
msgid "Cancel"
msgstr "Abbrechen"

#: src/qml/ProgressWindow.qml:145
#, kde-format
msgid "Stop"
msgstr "Anhalten"

#, kde-format
#~ msgid "Number of steps the progress bar counts to. Default 100."
#~ msgstr ""
#~ "Anzahl der Schritte, bis zu der der Fortschrittsbalken zählt. Vorgabe ist "
#~ "100."
